.snakemake/
.nextflow/
logs/
*.o*
*.e*
assembly_*.*

# Large data (keep paths in yaml; store reads/assemblies elsewhere)
raw_data/
pacbio/
hi-c/
*.bam
*.cram
*.fastq
*.fastq.gz
*.fq
*.fq.gz

# Large assembly outputs (track cutoffs/bed/summaries via exceptions below)
**/results/**/*.fasta
**/results/**/*.fa
**/results/**/*.paf
**/results/**/*.bam
**/results/**/*.bai
**/results/**/*.cov
**/results/purge_dups/assembly.purged.fasta.*
**/results/scaffolding/
**/results/_restage_backup_*/

# BUSCO working trees (keep busco_summary.txt)
**/results/qc/busco/**/run_*/
**/results/qc/busco/**/tmp/
busco_*.log
busco_downloads/

# Logs at project root
*.log

# Keep small reproducibility artifacts
